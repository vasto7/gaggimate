diff --git a/test/test_valve_offset/test_valve_offset.cpp b/test/test_valve_offset/test_valve_offset.cpp
new file mode 100644
index 00000000..7bfbb5e8
--- /dev/null
+++ b/test/test_valve_offset/test_valve_offset.cpp
@@ -0,0 +1,230 @@
+// Unit tests: flow-derived mushroom-valve pressure offset (valveOffsetAt).
+// Host-side, no ESP32/Arduino runtime — pio test -e native -f test_valve_offset.
+//
+// Reference numbers come from the DeLonghi ECP 3420 valve characterisation in
+// claude/gaggimate-flow-model-offset-reference.md: cracking ~4.0 bar, full open ~6.6 bar at
+// 4.45 g/s, and a measured drop-vs-flow line of ~0.712*F + 4.103 across the extraction band.
+
+#include <unity.h>
+
+#include <cmath>
+#include <limits>
+
+#include "display/core/ValveOffset.h"
+
+// The two calibration points a user would enter after the documented 5-and-6-bar procedure,
+// using this machine's measured flows.
+static constexpr float P1 = 5.0f, F1 = 1.19f;
+static constexpr float P2 = 6.0f, F2 = 2.90f;
+static constexpr float FIXED = 5.0f; // the fallback constant offset
+static constexpr float NO_CAP = 0.0f; // an unset wide-open pressure leaves the line unbounded
+// Measured with the portafilter out and the pump at full power: the valve is as far open as it
+// goes, so this is the most drop it can produce however far the line is extrapolated.
+static constexpr float PMAX = 6.60f;
+static constexpr float FMAX = 4.45f;
+
+static float derived(float flow) { return valveOffsetAt(flow, FIXED, true, P1, F1, P2, F2, NO_CAP); }
+static float capped(float flow) { return valveOffsetAt(flow, FIXED, true, P1, F1, P2, F2, PMAX); }
+
+// --- constant mode is untouched -------------------------------------------------------------
+
+void test_constant_mode_ignores_flow(void) {
+    for (float q : {0.0f, 1.0f, 2.0f, 9.9f}) {
+        TEST_ASSERT_EQUAL_FLOAT(FIXED, valveOffsetAt(q, FIXED, false, P1, F1, P2, F2, NO_CAP));
+    }
+}
+
+void test_constant_mode_passes_zero_through(void) {
+    // The 3-way-solenoid default: offset 0 must stay exactly 0.
+    TEST_ASSERT_EQUAL_FLOAT(0.0f, valveOffsetAt(1.5f, 0.0f, false, P1, F1, P2, F2, NO_CAP));
+}
+
+// --- the line itself -------------------------------------------------------------------------
+
+void test_line_passes_through_both_calibration_points(void) {
+    TEST_ASSERT_FLOAT_WITHIN(0.001f, P1, derived(F1));
+    TEST_ASSERT_FLOAT_WITHIN(0.001f, P2, derived(F2));
+}
+
+void test_offset_rises_with_flow(void) {
+    TEST_ASSERT_TRUE(derived(2.0f) > derived(1.0f));
+    TEST_ASSERT_TRUE(derived(1.0f) > derived(0.5f));
+}
+
+void test_matches_measured_valve_curve_in_the_extraction_band(void) {
+    // Against "curve B" in the reference doc, 0.7100*F + 4.110, fitted where shots actually run.
+    // The 5-and-6-bar calibration is a chord across a slightly concave curve, so it over-reads at
+    // the bottom of the band and under-reads at the top; the documented worst case is +0.075 to
+    // -0.058 bar between 0.95 and 2.01 g/s.
+    for (float q : {0.95f, 1.19f, 1.40f, 1.60f, 1.85f, 2.01f}) {
+        const float reference = 0.7100f * q + 4.110f;
+        TEST_ASSERT_FLOAT_WITHIN(0.08f, reference, derived(q));
+    }
+}
+
+void test_known_operating_points(void) {
+    // Sanity anchors a human can check by hand: slope 1/(2.90-1.19) = 0.5848 bar per g/s,
+    // intercept 5.0 - 0.5848*1.19 = 4.3041.
+    TEST_ASSERT_FLOAT_WITHIN(0.005f, 4.8889f, derived(1.0f));
+    TEST_ASSERT_FLOAT_WITHIN(0.005f, 5.4737f, derived(2.0f));
+}
+
+// --- guards: anything unusable must fall back to the fixed offset -----------------------------
+
+void test_equal_flows_fall_back(void) {
+    // Would divide by zero.
+    TEST_ASSERT_EQUAL_FLOAT(FIXED, valveOffsetAt(1.5f, FIXED, true, 5.0f, 1.19f, 6.0f, 1.19f, NO_CAP));
+}
+
+void test_inverted_flows_fall_back(void) {
+    // Would give a negative slope — more flow, less drop, physically impossible for this valve.
+    TEST_ASSERT_EQUAL_FLOAT(FIXED, valveOffsetAt(1.5f, FIXED, true, 5.0f, 2.90f, 6.0f, 1.19f, NO_CAP));
+}
+
+void test_inverted_pressures_fall_back(void) {
+    TEST_ASSERT_EQUAL_FLOAT(FIXED, valveOffsetAt(1.5f, FIXED, true, 6.0f, 1.19f, 5.0f, 2.90f, NO_CAP));
+}
+
+void test_implausible_slope_falls_back(void) {
+    // The fat-finger case: two flows one digit apart give a slope of 100 bar per g/s.
+    TEST_ASSERT_EQUAL_FLOAT(FIXED, valveOffsetAt(1.5f, FIXED, true, 5.0f, 1.19f, 6.0f, 1.20f, NO_CAP));
+    // And the opposite, a slope far too shallow to be a spring valve.
+    TEST_ASSERT_EQUAL_FLOAT(FIXED, valveOffsetAt(1.5f, FIXED, true, 5.0f, 1.0f, 6.0f, 20.0f, NO_CAP));
+}
+
+void test_non_finite_inputs_fall_back(void) {
+    const float nan = std::nanf("");
+    TEST_ASSERT_EQUAL_FLOAT(FIXED, valveOffsetAt(nan, FIXED, true, P1, F1, P2, F2, NO_CAP));
+    TEST_ASSERT_EQUAL_FLOAT(FIXED, valveOffsetAt(1.5f, FIXED, true, nan, F1, P2, F2, NO_CAP));
+    TEST_ASSERT_EQUAL_FLOAT(FIXED, valveOffsetAt(1.5f, FIXED, true, P1, F1, P2, nan, NO_CAP));
+}
+
+void test_uncalibrated_defaults_fall_back(void) {
+    // Both flows still at their 0.0 default: the mode is on but nothing has been measured.
+    TEST_ASSERT_EQUAL_FLOAT(FIXED, valveOffsetAt(1.5f, FIXED, true, DEFAULT_VALVE_CAL_P1, DEFAULT_VALVE_CAL_F1,
+                                                DEFAULT_VALVE_CAL_P2, DEFAULT_VALVE_CAL_F2, NO_CAP));
+}
+
+void test_negative_flow_does_not_invert_the_offset(void) {
+    // A spurious negative reading must not pull the offset below the cracking intercept.
+    const float intercept = derived(0.0f);
+    TEST_ASSERT_EQUAL_FLOAT(intercept, derived(-3.0f));
+}
+
+// --- the commanded system pressure stays sane -------------------------------------------------
+
+void test_extraction_regime_command_stays_clear_of_the_gain_cliff(void) {
+    // Nothing downstream clamps the setpoint, and the controller's gain schedule runs away as
+    // *measured* pressure approaches _maxPressure = 15. During extraction the pump itself bounds
+    // the flow: at a commanded ~14 bar, geo(14) is about 1.6 g/s, so 1.7 is already generous.
+    // Across that whole regime 9 + offset must stay clear of the cliff.
+    for (float q = 0.0f; q <= 1.7f; q += 0.05f) {
+        TEST_ASSERT_TRUE(9.0f + derived(q) < 14.5f);
+    }
+}
+
+void test_fill_regime_command_is_high_but_bounded(void) {
+    // Deliberate design decision, recorded here so it is not mistaken for an oversight.
+    //
+    // During the fill phase pressure is low, so geo(P) is large and flow of 3-4 g/s is normal.
+    // The offset follows it and the commanded pressure goes above 15 — at 3.0 g/s it is 15.06,
+    // at the valve's full-open 4.45 g/s it is 15.91. There is deliberately no clamp, because in
+    // that regime the pump is already saturated: it cannot reach 6 bar at 4 g/s, let alone 15, so
+    // the inflated target changes nothing it does. As pressure builds, geo falls, flow falls, and
+    // the target glides back down to ~14 before the controller leaves saturation and starts
+    // regulating. The physics self-gates.
+    //
+    // What must hold is that the number stays bounded and monotonic rather than running away.
+    TEST_ASSERT_TRUE(9.0f + derived(3.0f) > 15.0f);  // documents the behaviour
+    TEST_ASSERT_TRUE(9.0f + derived(4.45f) < 16.5f); // but bounded at the valve's full-open flow
+    TEST_ASSERT_TRUE(derived(4.45f) > derived(3.0f));
+}
+
+void setUp(void) { /* No shared fixture state. */ }
+void tearDown(void) { /* No shared fixture state. */ }
+
+// --- the full-open cap ------------------------------------------------------------------------
+
+void test_cap_does_not_touch_the_extraction_band(void) {
+    // The line reaches PMAX at (PMAX - intercept) / slope = 3.93 g/s. A shot lives well below
+    // that, so capping must leave brewing pressures bit-identical.
+    for (float q : {0.4f, 0.8f, 1.2f, 1.6f, 2.0f, 2.5f, 3.0f}) {
+        TEST_ASSERT_EQUAL_FLOAT(derived(q), capped(q));
+    }
+}
+
+void test_cap_holds_above_the_crossing_flow(void) {
+    // Fill-phase flows, where the uncapped line claims more than the valve can produce.
+    TEST_ASSERT_FLOAT_WITHIN(0.01f, PMAX, capped(4.0f));
+    TEST_ASSERT_FLOAT_WITHIN(0.01f, PMAX, capped(FMAX));
+    TEST_ASSERT_FLOAT_WITHIN(0.01f, PMAX, capped(5.28f)); // the peak seen on shot 206
+    TEST_ASSERT_FLOAT_WITHIN(0.01f, PMAX, capped(99.0f));
+}
+
+void test_uncapped_line_still_overshoots(void) {
+    // Guards the premise: without a cap the model really does ask for more than 6.60 bar, which
+    // is the defect this exists to fix. If this ever fails the calibration has changed.
+    TEST_ASSERT_TRUE(derived(FMAX) > PMAX);
+    TEST_ASSERT_TRUE(derived(5.28f) > PMAX);
+}
+
+void test_cap_at_or_below_the_second_point_is_ignored(void) {
+    // Honouring it would clip a pressure the user measured, leaving them worse off than no cap.
+    TEST_ASSERT_EQUAL_FLOAT(derived(5.0f), valveOffsetAt(5.0f, FIXED, true, P1, F1, P2, F2, P2));
+    TEST_ASSERT_EQUAL_FLOAT(derived(5.0f), valveOffsetAt(5.0f, FIXED, true, P1, F1, P2, F2, 5.5f));
+    TEST_ASSERT_EQUAL_FLOAT(derived(5.0f), valveOffsetAt(5.0f, FIXED, true, P1, F1, P2, F2, 0.0f));
+}
+
+void test_non_finite_cap_is_ignored(void) {
+    const float nan = std::numeric_limits<float>::quiet_NaN();
+    const float inf = std::numeric_limits<float>::infinity();
+    TEST_ASSERT_EQUAL_FLOAT(derived(5.0f), valveOffsetAt(5.0f, FIXED, true, P1, F1, P2, F2, nan));
+    TEST_ASSERT_EQUAL_FLOAT(derived(5.0f), valveOffsetAt(5.0f, FIXED, true, P1, F1, P2, F2, inf));
+}
+
+void test_cap_does_not_apply_in_constant_mode(void) {
+    TEST_ASSERT_EQUAL_FLOAT(FIXED, valveOffsetAt(9.0f, FIXED, false, P1, F1, P2, F2, PMAX));
+}
+
+void test_offset_never_goes_negative(void) {
+    // The permitted slope band allows a calibration whose line is below zero at low flow.
+    // A restriction subtracts pressure, so the result is floored rather than inverting the sign.
+    const float neg = valveOffsetAt(0.0f, FIXED, true, 1.0f, 1.0f, 3.0f, 2.0f, NO_CAP);
+    TEST_ASSERT_EQUAL_FLOAT(0.0f, neg);
+    TEST_ASSERT_TRUE(valveOffsetAt(0.2f, FIXED, true, 1.0f, 1.0f, 3.0f, 2.0f, NO_CAP) >= 0.0f);
+}
+
+void test_capped_command_clears_the_gain_cliff_margin(void) {
+    // Peak commanded system pressure is the display target plus the offset. Capping brings the
+    // fill-phase peak down from 15.4 to 14.6 bar on an 8 bar target.
+    TEST_ASSERT_FLOAT_WITHIN(0.01f, 14.60f, 8.0f + capped(5.28f));
+    TEST_ASSERT_TRUE(8.0f + derived(5.28f) > 15.0f);
+}
+
+int main(int, char **) {
+    UNITY_BEGIN();
+    RUN_TEST(test_constant_mode_ignores_flow);
+    RUN_TEST(test_constant_mode_passes_zero_through);
+    RUN_TEST(test_line_passes_through_both_calibration_points);
+    RUN_TEST(test_offset_rises_with_flow);
+    RUN_TEST(test_matches_measured_valve_curve_in_the_extraction_band);
+    RUN_TEST(test_known_operating_points);
+    RUN_TEST(test_equal_flows_fall_back);
+    RUN_TEST(test_inverted_flows_fall_back);
+    RUN_TEST(test_inverted_pressures_fall_back);
+    RUN_TEST(test_implausible_slope_falls_back);
+    RUN_TEST(test_non_finite_inputs_fall_back);
+    RUN_TEST(test_uncalibrated_defaults_fall_back);
+    RUN_TEST(test_negative_flow_does_not_invert_the_offset);
+    RUN_TEST(test_extraction_regime_command_stays_clear_of_the_gain_cliff);
+    RUN_TEST(test_fill_regime_command_is_high_but_bounded);
+    RUN_TEST(test_cap_does_not_touch_the_extraction_band);
+    RUN_TEST(test_cap_holds_above_the_crossing_flow);
+    RUN_TEST(test_uncapped_line_still_overshoots);
+    RUN_TEST(test_cap_at_or_below_the_second_point_is_ignored);
+    RUN_TEST(test_non_finite_cap_is_ignored);
+    RUN_TEST(test_cap_does_not_apply_in_constant_mode);
+    RUN_TEST(test_offset_never_goes_negative);
+    RUN_TEST(test_capped_command_clears_the_gain_cliff_margin);
+    return UNITY_END();
+}
