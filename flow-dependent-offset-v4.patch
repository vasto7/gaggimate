+// Plausibility band for the mushroom-valve slope, bar per g/s. Mirrors VALVE_CAL_MIN_SLOPE /
+// VALVE_CAL_MAX_SLOPE in src/display/core/constants.h — keep the two in step.
+const VALVE_CAL_MIN_SLOPE = 0.3;
+const VALVE_CAL_MAX_SLOPE = 2.0;
+
+// Two measured (pressure, flow) points define the valve's drop-vs-flow line. Returns an error
+// string instead of a line whenever the pair cannot describe a valve, which is the same set of
+// conditions the firmware falls back to the fixed offset on.
+function valveLine(formData) {
+  const p1 = parseFloat(formData.valveCalP1);
+  const f1 = parseFloat(formData.valveCalF1);
+  const p2 = parseFloat(formData.valveCalP2);
+  const f2 = parseFloat(formData.valveCalF2);
+  if (![p1, f1, p2, f2].every(Number.isFinite)) {
+    return { error: 'Enter a pressure and a flow for both points.' };
+  }
+  if (!(p2 > p1)) return { error: 'The second pressure must be higher than the first.' };
+  if (!(f2 > f1)) return { error: 'The second flow must be higher than the first.' };
+  const slope = (p2 - p1) / (f2 - f1);
+  if (slope < VALVE_CAL_MIN_SLOPE || slope > VALVE_CAL_MAX_SLOPE) {
+    return {
+      error:
+        `That works out to ${slope.toFixed(2)} bar per g/s, outside the plausible ` +
+        `${VALVE_CAL_MIN_SLOPE}–${VALVE_CAL_MAX_SLOPE}. Check the two flow readings.`,
+    };
+  }
+  const intercept = p1 - slope * f1;
+  // Wide open is optional. Blank or zero leaves the line unbounded, which is how it shipped.
+  const pMax = parseFloat(formData.valveCalPMax);
+  const fMax = parseFloat(formData.valveCalFMax);
+  const hasMax = Number.isFinite(pMax) && pMax > 0;
+  const hasMaxFlow = Number.isFinite(fMax) && fMax > 0;
+  if (hasMax || hasMaxFlow) {
+    if (!(hasMax && hasMaxFlow)) {
+      return { error: 'Enter both a pressure and a flow for wide open, or leave both blank.' };
+    }
+    // A cap at or below point 2 would clip a pressure the user measured. Same for the flow:
+    // a wide-open point that is not past point 2 is not a wide-open point.
+    if (!(pMax > p2)) {
+      return { error: 'Wide-open pressure must be higher than point 2.' };
+    }
+    if (!(fMax > f2)) {
+      return { error: 'Wide-open flow must be higher than point 2.' };
+    }
+  }
+  const cap = hasMax ? pMax : Infinity;
+  return {
+    slope,
+    intercept,
+    pMax: hasMax ? pMax : null,
+    at: q => Math.max(0, Math.min(cap, intercept + slope * q)),
+  };
+}
