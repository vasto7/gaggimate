+// Record the settings the samples cannot be read without. Without these an export has to assume
+// whatever the UI happens to say when it runs, which is wrong for any shot pulled before a change.
+void ShotHistoryPlugin::writeSettingsSnapshot(ShotLogHeader &h) const {
+    Settings &settings = controller->getSettings();
+    h.settingsVersion = 2; // 2 adds pressureOffsetCap
+    h.settingsFlags = 0;
+    h.pressureOffsetModelVersion = 1;
+    if (settings.isPressureOffsetFlowDerived()) {
+        // Same construction as valveOffsetAt(): the two calibration points define the line.
+        const float f1 = settings.getValveCalF1(), f2 = settings.getValveCalF2();
+        const float p1 = settings.getValveCalP1(), p2 = settings.getValveCalP2();
+        const float slope = (f2 > f1) ? (p2 - p1) / (f2 - f1) : 0.0f;
+        h.pressureOffsetMode = slope != 0.0f ? 1 : 0;
+        h.pressureOffsetSlope = slope;
+        h.pressureOffsetIntercept = slope != 0.0f ? p1 - slope * f1 : settings.getPressureOffset();
+    } else {
