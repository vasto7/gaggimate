diff --git a/src/display/core/ValveOffset.h b/src/display/core/ValveOffset.h
new file mode 100644
index 0000000..017cdc6
--- /dev/null
+++ b/src/display/core/ValveOffset.h
@@ -0,0 +1,50 @@
+#ifndef VALVE_OFFSET_H
+#define VALVE_OFFSET_H
+
+#include <algorithm>
+#include <cmath>
+#include <display/core/constants.h>
+
+// Flow-derived mushroom-valve pressure offset.
+//
+// A spring-loaded mushroom valve (DeLonghi ECP/Stilosa and similar) is a regulator, not a fixed
+// restriction: the pressure it eats is a single-valued function of the flow through it, and near
+// enough linear across the range an espresso shot runs in. A constant offset is therefore correct
+// at exactly one flow rate, so brew pressure at the puck drifts as flow changes through the
+// extraction — measurably, by 0.4 to 0.7 bar on a typical shot.
+//
+// Two measured (pressure, flow) points define the line. Calibration is done with no puck in the
+// portafilter: hold a pressure, weigh the water, repeat at a second pressure about a bar higher.
+//
+// Kept free-standing and header-only so it has no Arduino or ESP-IDF dependency and can be unit
+// tested natively (see test/test_valve_offset).
+//
+//   flow         current pump flow, g/s (the firmware's own estimate)
+//   fixedOffset  the constant Pressure Offset setting, used whenever the derived line is unusable
+//   flowDerived  whether the user enabled the flow-derived mode
+//   p1,f1,p2,f2  the two calibration points
+//
+// Returns the offset in bar to add to the brew pressure target and subtract from readings.
+inline float valveOffsetAt(float flow, float fixedOffset, bool flowDerived, float p1, float f1, float p2,
+                           float f2) {
+    if (!flowDerived)
+        return fixedOffset;
+    // The web UI rejects these before they are stored, but the settings registry is also writable
+    // over the API and survives firmware downgrades, so never trust the stored values: anything
+    // that cannot describe a valve falls back to the fixed offset rather than commanding a
+    // pressure derived from nonsense. Note nothing downstream clamps the commanded setpoint.
+    if (!std::isfinite(p1) || !std::isfinite(f1) || !std::isfinite(p2) || !std::isfinite(f2))
+        return fixedOffset;
+    if (!(f2 > f1) || !(p2 > p1))
+        return fixedOffset;
+    const float slope = (p2 - p1) / (f2 - f1);
+    if (slope < VALVE_CAL_MIN_SLOPE || slope > VALVE_CAL_MAX_SLOPE)
+        return fixedOffset;
+    if (!std::isfinite(flow))
+        return fixedOffset;
+    // Flow below the first calibration point extrapolates back toward the valve's cracking
+    // pressure, which is intended; clamping at zero only stops a negative reading inverting it.
+    return (p1 - slope * f1) + slope * std::max(0.0f, flow);
+}
+
+#endif // VALVE_OFFSET_H
